// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

// ==============================================================================

enum UserStatus{
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender{
  MALE
  FEMALE
}

model User{
  id                    String        @id @default(uuid())   // @id ->primary key (uuid) generate an id 
  firstName             String 
  lastName              String 
  email                 String        @unique                // cant share the same email
  phone                 String        @unique
  passwordHash          String
  emailVerified         Boolean 
  lastLoginAt           DateTime?
  status                UserStatus    @default(PENDING)
  createdAt             DateTime      @default(now())
  updated               DateTime      @updatedAt
  role                  Role?         @relation(fields: [roleId], reference: [id])
  roleId                String?
 
  profile               Profile?
  refreshToken          RefreshToken[]
  audilogs              Auditlog[]


  @@index([roleId])
  @@index([status])


}

model Role{
  id                    String        @id @default(uuid()) // @id ->primary key (uuid) generate an id 
  name                  String        @unique
  slug                  String        @unique
  description           String?                            // Optional field
  user                  User[]
  rolePermission        RolePermission[]


  createdAt             DateTime      @default(now())
  updated               DateTime      @updatedAt

}


model Permission{
  id                    String        @id @default(uuid()) // @id ->primary key (uuid) generate an id 
  name                  String        @unique
  slug                  String        @unique
  description           String?                            // not required 
  rolePermission        RolePermission[]


  createdAt             DateTime      @default(now())
  updated               DateTime      @updatedAt

}

model RolePermission{
  roleId                    String        @id @default(uuid()) // @id ->primary key (uuid) generate an id
  permissionId              String

  permission                Permission?   @relation(fields:[permissionId], reference:[id],onDelete: Cascade)
  createdAt                 DateTime      @default(now())
  updated                   DateTime      @updatedAt
  roleId                    Role          @relation(fields:[permissionId], reference:[id],onDelete: Cascade)


  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Profile{
  id                    String        @id @default(uuid()) // @id ->primary key (uuid) generate an id
  gender                Gender
  dateOfBirth           DateTime?
  avartar               String?
  bio                   String?
  city                  String?
  state                 String?
  country               String?
  postalCode            String?
  userId                String          @unique
  
  user User             @relation(fields: [userId], reference:[id],onDelete:Cascade)
}

model RefreshToken{
  id                    String        @id @default(uuid()) // @id ->primary key (uuid) generate an id
  token                 String        @unique
  expiresat             DateTime
  IsRevoked             Boolean       @default(false)
  revokedAt             DateTime?
  deviceName            String?
  iPAddress             String?
  userAgent             String?
  UserId                String
  user                  User          @reference(fields:[UserId], reference:[id], onDelete: Cascade)
  createdAt             DateTime      @default(now())

  @@index([UserId])
}

model Auditlog{
  id                    String        @id @default(uuid()) // @id ->primary key (uuid) generate an id
  action                String  
  entity                String?

  description           String?
  iPAddress             String?
  userAgent             String?
  metadata              Json?
  UserId                String?
  user                  User?          @reference(fields:[UserId], reference:[id] onDelete: SetNull)

  createdAt             DateTime       @default(now())

  @@index([UserId])
  @@index([entity])







}