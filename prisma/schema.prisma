// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

# ==============================================================================
enum UserStatus{
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender{
  MALE
  FEMALE
}

model User{
  id                    String        @id @default(uuid()) # @id ->primary key (uuid) generate an id 
  firstName             String 
  lastName              String 
  email                 String        @unique              # cant share the same email
  phone                 String        @unique
  passwordHash          String
  emailVerified         Boolean 
  lastLoginAt           DateTime?
  status                UserStatus    @default(PENDING)
  createdAt             DateTime      @default(now())
  updated               DateTime      @updatedAt
}

model Role{
  id                    String        @id @default(uuid()) # @id ->primary key (uuid) generate an id 
  name                  String        @unique
  slug                  String        @unique
  description           String?                            # not required 
  user                  User[]
  rolePermission        RolePermission[]


  createdAt             DateTime      @default(now())
  updated               DateTime      @updatedAt

}


model Permission{
  id                    String        @id @default(uuid()) # @id ->primary key (uuid) generate an id 
  name                  String        @unique
  slug                  String        @unique
  description           String?                            # not required 
  rolePermission        RolePermission[]


  createdAt             DateTime      @default(now())
  updated               DateTime      @updatedAt

}

model RolePermission{
  roleId                    String        @id @default(uuid()) # @id ->primary key (uuid) generate an id
  permissionId              String

  permission                Permission?   @relation(fields:[permissionId], reference:[id])
  createdAt                 DateTime      @default(now())
  updated                   DateTime      @updatedAt


  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])

}